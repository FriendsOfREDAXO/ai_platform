# Included by .tools/rexstan.php so tests/unit can be analysed.
#
# PHPUnit lives in .tools/vendor: the addon's own vendor/ is shipped and must not
# carry dev tools. scanDirectories cannot reach it, because rexstan excludes
# '*/vendor/*' and that exclusion applies to scanning too. ycom gets away with it
# only because REDAXO's boot registers ycom's vendor/autoload.php, which carries
# PHPUnit there. Registering this autoloader does the same for .tools/vendor.
parameters:
    bootstrapFiles:
        - vendor/autoload.php
