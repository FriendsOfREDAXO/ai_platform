{
    "name": "friendsofredaxo/ai-platform-tools",
    "description": "Development tools for the ai_platform addon. Kept apart from the addon's composer.json because vendor/ there is committed and shipped: dev tools must never end up in it.",
    "require": {
        "redaxo/php-cs-fixer-config": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.14",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "cs-dry": "php-cs-fixer fix -v --ansi --dry-run --config=../.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix -v --ansi --config=../.php-cs-fixer.dist.php",
        "unit-test": "phpunit --testdox --configuration=../phpunit.xml.dist"
    }
}
