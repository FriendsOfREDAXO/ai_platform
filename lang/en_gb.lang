ai_platform_mcp_tool_public = public
ai_platform_mcp_tool_protected = protected
ai_platform_mcp_tools_notice = Disabled tools are neither listed (tools/list) nor executed (tools/call) for MCP clients. Newly registered tools are active by default.
ai_platform_mcp_tools_saved = Tool activation saved.
ai_platform_mcp_no_tools = No tools registered yet. Other addons can provide tools via the "AI_PLATFORM_MCP_TOOLS" extension point.
